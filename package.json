{
  "name": "gridwork",
  "productName": "Gridwork",
  "description": "A local workbench for solving variant sudoku puzzles. It never solves them for you.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test:importer": "tsx scripts/smoke-test-importer.ts",
    "test:validate": "tsx scripts/smoke-test-validate.ts",
    "typecheck": "tsc --noEmit",
    "test:phase4": "tsx scripts/smoke-test-phase4.ts",
    "test:scl": "tsx scripts/smoke-test-scl.ts",
    "test:selection": "tsx scripts/smoke-test-selection.ts",
    "test:board": "tsx scripts/smoke-test-board.ts",
    "test:fog": "tsx scripts/smoke-test-fog.ts",
    "test": "npm run typecheck && npm run test:importer && npm run test:scl && npm run test:validate && npm run test:phase4 && npm run test:selection && npm run test:board && npm run test:fog"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^26.4.0",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "lz-string": "^1.5.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "electron@44.0.0": true
  },
  "main": "out/main/index.js"
}
