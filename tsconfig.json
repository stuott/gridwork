{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "electron", "vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Type safety. The codebase was already written to strict rules
       (non-null assertions, optional chaining) but the flag was never
       turned on, so none of it was actually being enforced. Verified
       clean: `tsc --noEmit` reports 0 errors with this on. */
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "scripts", "electron.vite.config.ts"]
}
